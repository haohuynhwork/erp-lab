# Copy to .env (`make env`) and fill in. Read by the Makefile, compose.yaml and the apps.

# --- Project ---
PROJECT_NAME=erp-lab

# --- Database (PostgreSQL 17 + TimescaleDB) ---
POSTGRES_USER=erp
# Required in prod; compose refuses to start without it.
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp
# Host port for Postgres (dev only).
DB_PORT=5432

# --- MQTT (Mosquitto) ---
MQTT_PORT=1883

# --- URLs ---
# Public URLs, base path included. Their paths are the prefixes: the web app is served
# under /web and every api route (REST /v1, /graphql, /docs, /ws) under /api.
# The api uses WEB_URL for CORS and links in emails/PDFs, API_URL for Swagger "servers".
# In dev the web dev server proxies the API_URL path to the api, so both can share an origin.
WEB_URL=http://localhost:5173/web
API_URL=http://localhost:8080/api

# --- API (Spring Boot) ---
# Port the api listens on.
API_PORT=8080
# Signs access and refresh tokens (HS256), at least 32 characters.
# Generate one with: openssl rand -base64 48. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
# Password of the 'admin' user created on first start (empty database).
SEED_PASSWORD=admin12345
# Swagger UI (/docs) and GraphiQL (/graphiql); set false in production.
API_DOCS=true
